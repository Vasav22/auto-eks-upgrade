{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "id": 1, "title": "Agent Healthy Nodes", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "eks_agent_nodes_total{condition=\"Ready\"}", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 2, "title": "CrashLoopBackOff Pods", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
      "targets": [{ "expr": "eks_agent_crashloop_pods_total", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 3, "title": "PDB Blockers", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "eks_agent_pdb_blockers_total", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 4, "title": "Node Health Over Time", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        { "expr": "eks_agent_nodes_total{condition=\"Ready\"}", "legendFormat": "Ready", "refId": "A" },
        { "expr": "eks_agent_nodes_total{condition=\"NotReady\"}", "legendFormat": "NotReady", "refId": "B" }
      ],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["eks", "health-agent"],
  "time": { "from": "now-3h", "to": "now" },
  "title": "EKS Health Agent",
  "uid": "eks-health-agent",
  "version": 1
}
