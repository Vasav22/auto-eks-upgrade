{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total Clusters",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "expr": "eks_fleet_total_clusters", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 2,
      "title": "Clusters Up to Date",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "expr": "eks_fleet_up_to_date_clusters", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 3,
      "title": "Active Upgrades",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [{ "expr": "eks_upgrade_jobs_total{status=\"IN_PROGRESS\"}", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 4,
      "title": "Failed Upgrades (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
      "targets": [{ "expr": "increase(eks_upgrade_jobs_total{status=\"FAILED\"}[24h])", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 5,
      "title": "Upgrade Job Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(eks_upgrade_jobs_total[5m])", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 6,
      "title": "Cluster Health Score",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "eks_cluster_health_score", "legendFormat": "{{cluster_id}}", "refId": "A" }
      ],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 7,
      "title": "API Request Duration (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(eks_api_request_duration_seconds_bucket[5m]))", "legendFormat": "p99 {{method}} {{path}}", "refId": "A" }
      ],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 8,
      "title": "Healthy vs Unhealthy Nodes",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "targets": [
        { "expr": "eks_fleet_healthy_clusters", "legendFormat": "Healthy", "refId": "A" },
        { "expr": "eks_fleet_unhealthy_clusters", "legendFormat": "Unhealthy", "refId": "B" }
      ],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 9,
      "title": "Remediation Proposals (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "targets": [{ "expr": "increase(eks_remediation_proposals_total[24h])", "refId": "A" }],
      "datasource": { "uid": "${DS_PROMETHEUS}" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["eks", "kubernetes", "upgrade"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(eks_cluster_health_score, cluster_id)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "cluster",
        "options": [],
        "query": { "query": "label_values(eks_cluster_health_score, cluster_id)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query",
        "label": "Cluster"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "EKS Upgrade Overview",
  "uid": "eks-upgrade-overview",
  "version": 1
}
