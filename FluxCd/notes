helm repo add fluxcd https://charts.fluxcd.io
helm repo update

kubectl apply -f https://raw.githubusercontent.com/fluxcd/helm-operator/master/deploy/crds.yaml

helm upgrade -i flux fluxcd/flux \
--set helm.version=v3 \
--set git.url=git@github.com:YOURUSER/flux-get-started \
--namespace opsera
helm upgrade -i helm-operator fluxcd/helm-operator \
--set git.ssh.secretName=flux-git-deploy \
--namespace opsera



#install flux ctl
sudo snap install fluxctl --classic
#give write access
fluxctl identity --k8s-fwd-ns opsera


helm repo add fluxcd https://charts.fluxcd.io
helm repo update

kubectl apply -f https://raw.githubusercontent.com/fluxcd/helm-operator/master/deploy/crds.yaml

helm install -i flux fluxcd/flux --wait --namespace fluxcd --set git.url=git@github.com:fluxcd/helm-operator-get-started
helm install -i helm-operator fluxcd/helm-operator --wait --namespace fluxcd --set git.ssh.secretName=flux-git-deploy --set helm.versions=v3
fluxctl identity --k8s-fwd-ns fluxcd



kubectl delete namespace fluxcd