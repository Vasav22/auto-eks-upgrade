def get_all_ingress():
    api_instance = client.NetworkingV1Api()

    try:
        api_response = api_instance.list_ingress_for_all_namespaces()
        all_ingresses = []
        for ingress in api_response.items:
            if not (ingress.metadata.namespace == 'NULL'):
              all_ingresses.append(ingress.spec.rules[0].host)
        print(all_ingresses)
        return all_ingresses
    except ApiException as e:
        print("Exception when calling NetworkingV1Api->list_ingress_for_all_namespaces: %s\n" % e)
        

def check_microservice_exists(namespace, label_selector):
      api_instance2 = client.CoreV1Api()
      try:
        # List Services in the namespace with the specified label selector
        service_list = api_instance2.list_namespaced_service(namespace, label_selector='name=opsera-jobengine-core')
        if service_list.items:
            print(f"Microservice with label selector '{label_selector}' exists in namespace '{namespace}'.")
            return True
        else:
            print(f"No microservice with label selector '{label_selector}' found in namespace '{namespace}'.")
            return False
      except client.exceptions.ApiException as e:
        print("Exception when calling CoreV1Api->list_namespaced_service: %s\n" % e)
        return False
      





def get_url(host):
    clus_type = "control-plane"
    url = 'https://' + host
    if ("jenkins" in host):
        url = url + '/login'
    if ("teamcity" in host):
        url = url + '/login.html'
    if ("anchore" in host):
        url = url + '/v1/'
    if (("8083-nexus" in host) or ("8082-nexus" in host)):
        url = url + '/v2/'
    if ("elasticsearch" in host):
        url= url + '/_cluster/health'
    if (clus_type == "control-plane"):
        if not (host.startswith('api.') or host.startswith('app.') or host.startswith('portal.') or host.startswith('archive-ubuntu') or host.startswith('mirror-centos')):
            url = url + '/status'
        if ("mirror-centos" in host):
            url = url + '/repos/'
    return url

