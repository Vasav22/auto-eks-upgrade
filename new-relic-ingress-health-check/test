def get_status(res):
    # Default backend
    if ("default backend - 404" in str(res.text)):
        print(res.text)
        return 10

    # Infra tools
    if ("<title>Kubernetes Dashboard</title>" in str(res.text)):
        return 1
    if ("<title>Prometheus Time Series Collection and Processing Server</title>" in str(res.text)):
        return 1
    if ("<title>Alertmanager</title>" in str(res.text)):
        return 1

    # Data plane services
    if ("ok" == str(res.text)):
        return 1

    # Customer spinned up tools
    if ("Welcome to Jenkins" in str(res.text)):
        print("Found 'Welcome to Jenkins'")
        return 1
    if ("<title>Argo CD</title>" in str(res.text)):
        print("Found '<title>Argo CD</title>'")
        return 1
    if ("<title>SonarQube</title>" in str(res.text)):
        print("Found '<title>SonarQube</title>'")
        return 1
    if ("<title>Nexus Repository Manager</title>" in str(res.text)):
        print("Found '<title>Nexus Repository Manager</title>'")
        return 1
    if ("access to the requested resource is not authorized" in str(res.text)):
        print("Found 'access to the requested resource is not authorized'")
        return 1

    if (res.status_code == 200):
        return 1

    return 0

def hit_url(url, ingress, auth):
    status = 0
    timeout = "false"
    default_backend = "false"
    status_code = 0

    print('Calling ' + url)
    try:
        s = requests.Session()
        retries = LogRetry(total=5,
            backoff_factor=0.5,
            status_forcelist=[ 500, 502, 503, 504 ])
        s.mount('http://', HTTPAdapter(max_retries=retries))
        s.mount('https://', HTTPAdapter(max_retries=retries))
        if not auth['enabled']:
            r = s.get(url, verify=False, timeout=2)
        else:
            r = s.get(url, auth=auth['creds'], timeout=2)
        status = get_status(r)
        if (status == 10):
            status = 0
        default_backend = "true"
        status_code = r.status_code
    except requests.exceptions.Timeout:
        status = 0
        timeout = "true"
    except Exception as e:
        print(e)
    return [ingress, status, status_code, timeout, default_backend]


