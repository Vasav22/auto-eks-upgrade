service_name=nodeapi
values_file_path=values-opsera-dev-microservices.yaml
k8_ns=microservices

helm upgrade opsera-${service_name} . \
        -n ${k8_ns} \
        --set DOCKER_ENV=kubernetes \
        --set image.tag=git-496ea2e411d430e32978c90153b93d4afd38e948 \
        -f ${values_file_path} 


kubectl -n microservices get po -l app.kubernetes.io/name=opsera-node-webhook-consumer-service

helm upgrade opsera-node-webhook-consumer-service . --install \
        -n microservices --set DOCKER_ENV=kubernetes \
        --set image.tag=638d33bf46bac00aa06aa55ac9618255601a3dfe \
        -f values-honeywell-platform-microservices.yaml

helm upgrade opsera-node-webhook-consumer-service . \
        -n microservices --install \
        --set image.tag=dev_3 \
        -f values-opsera-dev-microservices.yaml
