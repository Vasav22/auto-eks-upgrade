
helm install opsera-ansible-service . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev 

helm upgrade opsera-ansible-service . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev 


helm uninstall opsera-ansible-service . \
    -n microservices 



