
helm install opsera-packer-integrator . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev 

helm upgrade opsera-packer-integrator . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev 


helm uninstall opsera-packer-integrator . \
    -n microservices 



