service_name=nodeapi
values_file_path=values-opsera-dev-microservices.yaml
k8_ns=microservices

helm upgrade opsera-${service_name} . \
        -n ${k8_ns} \
        --set DOCKER_ENV=kubernetes \
        --set image.tag=git-496ea2e411d430e32978c90153b93d4afd38e948 \
        -f ${values_file_path} 


kubectl -n microservices get po -l app.kubernetes.io/name=opsera-user-management-service

helm upgrade opsera-user-management-service . \
        -n microservices --install --set image.tag=dev_9 \
        -f values-opsera-dev-microservices.yaml
