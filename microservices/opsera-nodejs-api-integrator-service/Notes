#production

helm install opsera-nodejs-api-integrator-service . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-prod \
    --set ingress.hosts[0].host=api-integrator-service.opsera-prod.opsera.io \
    --set ingress.hosts[0].paths[0]=/


helm upgrade opsera-nodejs-api-integrator-service . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-prod \
    --set ingress.hosts[0].host=api-integrator-service.opsera-prod.opsera.io \
    --set ingress.hosts[0].paths[0]=/



helm uninstall opsera-nodejs-api-integrator-service . \
    -n microservices 



kubectl -n microservices port-forward deployment/opsera-nodejs-api-integrator-service 5007:5007
kubectl -n microservices get deploy | grep -i "opsera-nodejs-api-integrator-service"

