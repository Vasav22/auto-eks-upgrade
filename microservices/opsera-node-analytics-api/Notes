
helm install opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev \
    --set ingress.hosts[0].host=analytics-api.opsera-dev.opsera.io \
    --set ingress.hosts[0].paths[0]=/


helm upgrade opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev \
    --set ingress.hosts[0].host=analytics-api.opsera-dev.opsera.io \
    --set ingress.hosts[0].paths[0]=/



helm uninstall opsera-node-analytics-api . \
    -n microservices 



