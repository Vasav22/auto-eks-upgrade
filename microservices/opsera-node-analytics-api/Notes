
service_name=node-analytics-api
k8_ns=microservices
values_file_path=values.yaml

helm upgrade opsera-${service_name} . \
        -n ${k8_ns} \
        --set DOCKER_ENV=kubernetes \
        --set image.tag=kube-prod \
        -f ${values_file_path} 
        
        helm install opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev \
    --set ingress.hosts[0].host=analytics-api.opsera-dev.opsera.io \
    --set ingress.hosts[0].paths[0]=/


helm upgrade opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev \
    --set ingress.hosts[0].host=analytics-api.opsera-dev.opsera.io \
    --set ingress.hosts[0].paths[0]=/



helm uninstall opsera-node-analytics-api . \
    -n microservices 



#test


helm install opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-test \
    --set ingress.hosts[0].host=analytics-api.opsera-test.opsera.io \
    --set ingress.hosts[0].paths[0]=/


helm upgrade opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-test \
    --set ingress.hosts[0].host=analytics-api.opsera-test.opsera.io \
    --set ingress.hosts[0].paths[0]=/



helm uninstall opsera-node-analytics-api . \
    -n microservices 

#production

helm install opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-prod \
    --set ingress.hosts[0].host=analytics-api.opsera-prod.opsera.io \
    --set ingress.hosts[0].paths[0]=/


helm upgrade opsera-node-analytics-api . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-prod \
    --set ingress.hosts[0].host=analytics-api.opsera-prod.opsera.io \
    --set ingress.hosts[0].paths[0]=/



helm uninstall opsera-node-analytics-api . \
    -n microservices 