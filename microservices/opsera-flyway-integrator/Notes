
helm install opsera-flyway-integrator . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev 

helm upgrade opsera-flyway-integrator . \
    -n microservices \
    --set DOCKER_ENV=kubernetes \
    --set image.tag=kube-dev 


helm uninstall opsera-flyway-integrator . \
    -n microservices 



